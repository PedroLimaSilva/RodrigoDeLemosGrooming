---
import '../styles/global.scss';
import { LOCALE_STORAGE_KEY } from '../i18n/constants';
import { pageMeta } from '../i18n/doc';

interface Props {
  title?: string;
  description?: string;
}

const defaultTitle = pageMeta.title.en;
const defaultDescription = pageMeta.description.en;
const { title = defaultTitle, description = defaultDescription } = Astro.props;

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const faviconSvg = `${basePath}/favicon.svg`;
const faviconPng = `${basePath}/favicon.png`;

const bootstrapPayload = {
  key: LOCALE_STORAGE_KEY,
  title: pageMeta.title,
  description: pageMeta.description,
};
const bootstrapScript = `(function(){var p=${JSON.stringify(bootstrapPayload)};var d=document;var pick=function(){try{var s=localStorage.getItem(p.key);if(s==="en"||s==="pt")return s;}catch(e){}var nav=(navigator.languages&&navigator.languages[0])||navigator.language||"en";var lo=String(nav).toLowerCase();if(lo==="pt"||lo.indexOf("pt-")===0)return"pt";return"en"};var lang=pick();d.documentElement.lang=lang;d.documentElement.setAttribute("data-site-locale",lang);d.title=p.title[lang]||p.title.en;var m=d.querySelector('meta[name="description"]');if(m)m.setAttribute("content",(p.description[lang]||p.description.en));})();`;
---

<!doctype html>
<html lang="en" data-locale-storage-key={LOCALE_STORAGE_KEY}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#840029" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" type="image/png" sizes="32x32" href={faviconPng} />
    <link rel="apple-touch-icon" href={`${basePath}/apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline set:html={bootstrapScript}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      <span class="i18n-en" lang="en">Skip to content</span><span class="i18n-pt" lang="pt">Saltar para o conteúdo</span>
    </a>
    <slot />
    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('[data-reveal]').forEach(function (el) {
            el.classList.add('is-revealed');
          });
          return;
        }
        var els = document.querySelectorAll('[data-reveal]');
        if (!els.length || !('IntersectionObserver' in window)) {
          els.forEach(function (el) {
            el.classList.add('is-revealed');
          });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
        );
        els.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        function storageKey() {
          return root.getAttribute('data-locale-storage-key') || 'candoro-site-locale';
        }
        function applyImageAlts() {
          var lang = root.lang === 'pt' ? 'pt' : 'en';
          document.querySelectorAll('[data-i18n-alt]').forEach(function (el) {
            var v = el.getAttribute('data-alt-' + lang);
            if (v != null) el.setAttribute('alt', v);
          });
        }
        function wireLocalePicker() {
          var key = storageKey();
          document.querySelectorAll('[data-set-site-locale]').forEach(function (btn) {
            btn.addEventListener('click', function () {
              var next = btn.getAttribute('data-set-site-locale');
              if (next !== 'en' && next !== 'pt') return;
              try {
                localStorage.setItem(key, next);
              } catch (e) {}
              location.reload();
            });
          });
        }
        applyImageAlts();
        wireLocalePicker();
      })();
    </script>
  </body>
</html>

<style lang="scss">
  @use '../styles/tokens' as *;

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: $ivory;
    color: $burgundy;
    font-family: $font-sans;
    font-weight: 600;
  }

  .skip-link:focus {
    left: 1rem;
    top: 1rem;
    outline: 2px solid $champagne;
    outline-offset: 2px;
  }
</style>

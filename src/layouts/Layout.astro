---
import '../styles/global.scss';
import SeoHead from '../components/SeoHead.astro';
import StructuredData from '../components/StructuredData.astro';
import type { SiteLocale } from '../i18n/constants';
import { pageMeta } from '../i18n/doc';
import { localePath } from '../i18n/seo';

interface Props {
  locale: SiteLocale;
  title?: string;
  description?: string;
}

const { locale, title = pageMeta.title[locale], description = pageMeta.description[locale] } =
  Astro.props;

const path = localePath(locale);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const faviconSvg = `${basePath}/favicon.svg`;
const faviconPng = `${basePath}/favicon.png`;
---

<!doctype html>
<html lang={locale} data-site-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#840029" />
    <SeoHead locale={locale} title={title} description={description} path={path} />
    <StructuredData locale={locale} />
    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" type="image/png" sizes="32x32" href={faviconPng} />
    <link rel="apple-touch-icon" href={`${basePath}/apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {locale === 'pt' ? (
        <span lang="pt">Saltar para o conteúdo</span>
      ) : (
        <span lang="en">Skip to content</span>
      )}
    </a>
    <slot />
    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('[data-reveal]').forEach(function (el) {
            el.classList.add('is-revealed');
          });
          return;
        }
        var els = document.querySelectorAll('[data-reveal]');
        if (!els.length || !('IntersectionObserver' in window)) {
          els.forEach(function (el) {
            el.classList.add('is-revealed');
          });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
        );
        els.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var lang = root.lang === 'pt' ? 'pt' : 'en';
        document.querySelectorAll('[data-i18n-alt]').forEach(function (el) {
          var v = el.getAttribute('data-alt-' + lang);
          if (v != null) el.setAttribute('alt', v);
        });
      })();
    </script>
  </body>
</html>

<style lang="scss">
  @use '../styles/tokens' as *;

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: $ivory;
    color: $burgundy;
    font-family: $font-sans;
    font-weight: 600;
  }

  .skip-link:focus {
    left: 1rem;
    top: 1rem;
    outline: 2px solid $champagne;
    outline-offset: 2px;
  }
</style>

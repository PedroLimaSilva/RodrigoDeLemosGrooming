---
import type { SiteLocale } from '../i18n/constants';
import { pageMeta } from '../i18n/doc';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Philosophy from '../components/Philosophy.astro';
import Services from '../components/Services.astro';
import Transformations from '../components/Transformations.astro';
import Competitions from '../components/Competitions.astro';
import Salon from '../components/Salon.astro';
import BookingCTA from '../components/BookingCTA.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  locale: SiteLocale;
}

const { locale } = Astro.props;
---

<Layout locale={locale} title={pageMeta.title[locale]} description={pageMeta.description[locale]}>
  <SiteHeader />
  <main id="main">
    <Hero />
    <Philosophy />
    <Services />
    <Transformations />
    <Competitions />
    <!-- <Testimonials /> -->
    <Salon />
    <BookingCTA />
  </main>
  <SiteFooter />
</Layout>

---
import type { SiteLocale } from '../i18n/constants';
import {
  absoluteUrl,
  alternateUrls,
  BUSINESS,
  OG_IMAGE,
} from '../i18n/seo';

interface Props {
  locale: SiteLocale;
  title: string;
  description: string;
  path: string;
}

const { locale, title, description, path } = Astro.props;

const canonical = absoluteUrl(path);
const alternates = alternateUrls();
const ogLocale = locale === 'pt' ? 'pt_PT' : 'en_GB';
const ogLocaleAlternate = locale === 'pt' ? 'en_GB' : 'pt_PT';
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="en" href={alternates.en} />
<link rel="alternate" hreflang="pt" href={alternates.pt} />
<link rel="alternate" hreflang="x-default" href={absoluteUrl('/en/')} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={OG_IMAGE} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={BUSINESS.name} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlternate} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={OG_IMAGE} />

---
import BrandLogo from './BrandLogo.astro';

const base = import.meta.env.BASE_URL;
const links = [
  { href: `${base}#home`, en: 'Home', pt: 'Início' },
  { href: `${base}#services`, en: 'Services', pt: 'Serviços' },
  { href: `${base}#portfolio`, en: 'Portfolio', pt: 'Portfólio' },
  { href: `${base}#philosophy`, en: 'About', pt: 'Sobre' },
  { href: `${base}#contact`, en: 'Contact', pt: 'Contacto' },
];
---

<header class="site-header" data-header>
  <div class="site-header__inner u-container">
    <BrandLogo />
    <span id="site-header-nav-label" class="visually-hidden">
      <span class="i18n-en" lang="en">Primary</span>
      <span class="i18n-pt" lang="pt">Principal</span>
    </span>
    <nav
      class="site-header__nav"
      id="site-header-primary-nav"
      data-header-nav
      aria-labelledby="site-header-nav-label"
    >
      <ul>
        {
          links.map(({ href, en, pt }) => (
            <li>
              <a href={href}>
                <span class="i18n-en" lang="en">{en}</span>
                <span class="i18n-pt" lang="pt">{pt}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a
      class="site-header__book"
      href="https://api.whatsapp.com/send?phone=+351935871091"
    >
      <span class="site-header__book-label">
        <span class="i18n-en" lang="en">Book appointment</span><span class="i18n-pt" lang="pt">Marcar visita</span>
      </span>
      <span class="site-header__book-label site-header__book-label--short" aria-hidden="true">
        <span class="i18n-en" lang="en">Book</span><span class="i18n-pt" lang="pt">Marcar</span>
      </span>
    </a>
    <button
      class="site-header__menu-toggle"
      type="button"
      data-header-menu-toggle
      aria-expanded="false"
      aria-controls="site-header-primary-nav"
      aria-label="Open menu"
    >
      <span class="site-header__menu-bars" aria-hidden="true">
        <span class="site-header__menu-bar"></span>
        <span class="site-header__menu-bar"></span>
        <span class="site-header__menu-bar"></span>
      </span>
    </button>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.querySelector('[data-header]');
    if (!header) return;

    function menuAria() {
      return document.documentElement.lang === 'pt'
        ? { open: 'Abrir menu', close: 'Fechar menu' }
        : { open: 'Open menu', close: 'Close menu' };
    }

    var onScroll = function () {
      header.classList.toggle('is-scrolled', window.scrollY > 48);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    var toggle = header.querySelector('[data-header-menu-toggle]');
    var nav = header.querySelector('[data-header-nav]');
    if (!toggle || !nav) return;

    toggle.setAttribute('aria-label', menuAria().open);

    var mq = window.matchMedia('(max-width: 1080px)');

    function onPointerDownOutside(e) {
      if (!header.classList.contains('is-menu-open') || !mq.matches) return;
      var t = e.target;
      if (nav.contains(t) || toggle.contains(t)) return;
      setMenuOpen(false);
    }

    function setMenuOpen(open) {
      header.classList.toggle('is-menu-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      var labels = menuAria();
      toggle.setAttribute('aria-label', open ? labels.close : labels.open);
      document.body.classList.toggle('is-header-menu-open', open && mq.matches);
      document.removeEventListener('pointerdown', onPointerDownOutside, true);
      if (open && mq.matches) {
        document.addEventListener('pointerdown', onPointerDownOutside, true);
      }
    }

    function closeIfDesktop() {
      if (!mq.matches) setMenuOpen(false);
    }

    toggle.addEventListener('click', function () {
      setMenuOpen(!header.classList.contains('is-menu-open'));
    });

    nav.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        setMenuOpen(false);
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setMenuOpen(false);
    });

    if (typeof mq.addEventListener === 'function') {
      mq.addEventListener('change', closeIfDesktop);
    } else {
      mq.addListener(closeIfDesktop);
    }
  })();
</script>

<style lang="scss">
  @use '../styles/tokens' as *;

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  $nav-collapse-bp: 1080px;

  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    padding: 1.35rem 0;
    padding-top: calc(1.35rem + env(safe-area-inset-top, 0px));
    color: rgba(255, 255, 255, 0.92);
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background $duration-medium $ease-out-expo,
      border-color $duration-medium $ease-out-expo,
      backdrop-filter $duration-medium $ease-out-expo;
  }

  .site-header.is-scrolled,
  .site-header.is-menu-open {
    background: rgba($burgundy, 0.94);
    border-bottom-color: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(8px);
  }

  .site-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 2rem);
    justify-content: space-between;
  }

  .site-header__nav {
    flex: 1;
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .site-header__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.75rem;
    flex-wrap: nowrap;
    justify-content: center;
  }

  .site-header__nav a {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 600;
    opacity: 0.88;
    transition: opacity $duration-medium $ease-out-expo;
  }

  .site-header__nav a:hover {
    opacity: 1;
    color: $champagne;
  }

  .site-header__book {
    flex-shrink: 0;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 600;
    padding: 0.65rem 1.1rem;
    border: 1px solid rgba($champagne, 0.65);
    color: $champagne;
    transition:
      background $duration-medium $ease-out-expo,
      color $duration-medium $ease-out-expo;
  }

  .site-header__book:hover {
    background: rgba($champagne, 0.12);
  }

  .site-header__book-label--short {
    display: none;
  }

  .site-header__menu-toggle {
    display: none;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin: 0;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 2px;
    background: rgba(0, 0, 0, 0.12);
    color: inherit;
    cursor: pointer;
    transition:
      border-color $duration-medium $ease-out-expo,
      background $duration-medium $ease-out-expo;
  }

  .site-header__menu-toggle:hover {
    border-color: rgba($champagne, 0.55);
    background: rgba($champagne, 0.08);
  }

  .site-header__menu-bars {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    width: 1.15rem;
  }

  .site-header__menu-bar {
    display: block;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition:
      transform $duration-medium $ease-out-expo,
      opacity $duration-medium $ease-out-expo;
    transform-origin: center;
  }

  .site-header.is-menu-open .site-header__menu-bar:nth-child(1) {
    transform: translateY(0.45rem) rotate(45deg);
  }

  .site-header.is-menu-open .site-header__menu-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .site-header.is-menu-open .site-header__menu-bar:nth-child(3) {
    transform: translateY(-0.45rem) rotate(-45deg);
  }

  @media (max-width: $nav-collapse-bp) {
    .site-header__menu-toggle {
      display: inline-flex;
    }

    .site-header__nav {
      position: absolute;
      top: calc(100% + 0.65rem);
      left: 0;
      right: 0;
      flex: none;
      justify-content: stretch;
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: linear-gradient(
        168deg,
        rgba($burgundy, 0.55) 0%,
        rgba($burgundy-deep, 0.98) 42%,
        rgba(0, 0, 0, 0.42) 100%
      );
      border: 1px solid rgba($champagne, 0.38);
      border-radius: 2px;
      box-shadow:
        0 0 0 1px rgba(0, 0, 0, 0.35) inset,
        0 28px 56px rgba(0, 0, 0, 0.38);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-0.35rem);
      transition:
        opacity $duration-medium $ease-out-expo,
        visibility $duration-medium $ease-out-expo,
        transform $duration-medium $ease-out-expo;
    }

    .site-header__nav::before {
      content: '';
      display: block;
      height: 2px;
      margin: 0 1.15rem;
      margin-bottom: 0.15rem;
      background: linear-gradient(
        90deg,
        transparent 0%,
        rgba($champagne, 0.2) 18%,
        rgba($champagne, 0.75) 50%,
        rgba($champagne, 0.2) 82%,
        transparent 100%
      );
      opacity: 0.95;
    }

    .site-header.is-menu-open .site-header__nav {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    .site-header__nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      flex-wrap: nowrap;
      width: 100%;
      padding: 0.2rem 0 0.35rem;
    }

    .site-header__nav li {
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    }

    .site-header__nav li:last-child {
      border-bottom: none;
    }

    .site-header__nav a {
      display: block;
      padding: 1.05rem 1.35rem;
      text-align: left;
      letter-spacing: 0.22em;
      font-size: 0.74rem;
      opacity: 0.94;
      color: rgba(255, 255, 255, 0.94);
      border-left: 2px solid transparent;
      transition:
        opacity $duration-medium $ease-out-expo,
        color $duration-medium $ease-out-expo,
        border-color $duration-medium $ease-out-expo,
        background $duration-medium $ease-out-expo,
        padding-left $duration-medium $ease-out-expo;
    }

    .site-header__nav a:hover {
      color: $champagne;
      background: rgba($champagne, 0.06);
      border-left-color: rgba($champagne, 0.55);
      padding-left: 1.5rem;
    }

    .site-header__nav a:focus-visible {
      outline: none;
      color: $champagne;
      background: rgba($champagne, 0.08);
      border-left-color: rgba($champagne, 0.85);
      padding-left: 1.5rem;
    }

    .site-header__book {
      padding: 0.55rem 0.75rem;
      letter-spacing: 0.12em;
    }

    .site-header__book-label:not(.site-header__book-label--short) {
      display: none;
    }

    .site-header__book-label--short {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__nav,
    .site-header__nav a,
    .site-header__menu-bar {
      transition: none;
    }

    .site-header.is-menu-open .site-header__menu-bar:nth-child(1),
    .site-header.is-menu-open .site-header__menu-bar:nth-child(3) {
      transform: none;
    }

    .site-header.is-menu-open .site-header__menu-bar:nth-child(2) {
      opacity: 0;
    }
  }
</style>

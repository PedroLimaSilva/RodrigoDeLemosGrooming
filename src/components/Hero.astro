---
import SculptureAccent from './SculptureAccent.astro';
---

<section class="hero" id="home" aria-labelledby="hero-heading">
  <div class="hero__scroll" aria-hidden="true">
    <span class="i18n-en" lang="en">Scroll</span><span class="i18n-pt" lang="pt">Deslizar</span>
  </div>
  <div class="hero__grid u-container">
    <div class="hero__copy" data-reveal>
      <p class="u-eyebrow hero__eyebrow">
        <span class="i18n-en" lang="en">Boutique care · refined results.</span><span class="i18n-pt" lang="pt"
          >Cuidado de boutique · resultados refinados.</span
        >
      </p>
      <h1 id="hero-heading" class="hero__title">
        <span class="i18n-en" lang="en">Refined grooming for exceptional dogs.</span><span class="i18n-pt" lang="pt"
          >Estética canina para cães excecionais.</span
        >
      </h1>
      <p class="hero__lede">
        <span class="i18n-en" lang="en"
          >An atelier approach to coat health and breed presentation — quiet rooms, deliberate pacing, and
          show-quality finishing.</span
        ><span class="i18n-pt" lang="pt"
          >Uma abordagem de atelier para a saúde do pelo e a apresentação da raça — salas silenciosas, ritmo
          deliberado e acabamentos de nível de exposição.</span
        >
      </p>
      <div class="hero__actions">
        <a class="hero__btn hero__btn--solid" href="https://api.whatsapp.com/send?phone=+351935871091">
          <span class="i18n-en" lang="en">Book appointment</span><span class="i18n-pt" lang="pt">Marcar visita</span>
        </a>
        <a class="hero__btn hero__btn--ghost" href={`${import.meta.env.BASE_URL}#services`}>
          <span class="i18n-en" lang="en">Explore services</span><span class="i18n-pt" lang="pt">Explorar serviços</span>
        </a>
      </div>
    </div>
    <div class="hero__art" data-reveal>
      <SculptureAccent variant="brass" class="hero__sculpture" />
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/tokens' as *;

  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    padding-top: env(safe-area-inset-top, 0px);
    background: radial-gradient(
      120% 80% at 80% 20%,
      $burgundy-hero-glow 0%,
      $burgundy 55%,
      $burgundy-hero-shadow 100%
    );
    color: rgba(255, 255, 255, 0.94);
    display: flex;
    flex-direction: column;
    padding-bottom: calc(4rem + env(safe-area-inset-bottom, 0px));
  }

  .hero__scroll {
    position: absolute;
    left: 1.5rem;
    bottom: 2.5rem;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.65rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    opacity: 0.45;
    font-weight: 600;
  }

  @media (max-width: 720px) {
    .hero__scroll {
      display: none;
    }
  }

  .hero__grid {
    flex: 1;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
    padding-top: clamp(6.5rem, 12vw, 8.5rem);
    padding-bottom: 3rem;
  }

  .hero__eyebrow {
    color: rgba($champagne, 0.95);
    margin-bottom: 1.25rem;
  }

  .hero__title {
    font-size: clamp(2.6rem, 5vw, 4.25rem);
    font-weight: 500;
    margin: 0 0 1.25rem;
    max-width: 14ch;
  }

  .hero__lede {
    font-size: 1.05rem;
    line-height: 1.75;
    max-width: 36ch;
    margin: 0 0 2.25rem;
    opacity: 0.88;
    font-weight: 400;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    text-decoration: none;
    padding: 0.85rem 1.35rem;
    border-radius: 0;
    transition:
      background $duration-medium $ease-out-expo,
      color $duration-medium $ease-out-expo,
      border-color $duration-medium $ease-out-expo;
  }

  .hero__btn--solid {
    background: $champagne;
    color: $burgundy;
    border: 1px solid transparent;
  }

  .hero__btn--solid:hover {
    background: $champagne-hover;
  }

  .hero__btn--ghost {
    border: 1px solid rgba($champagne, 0.55);
    color: $champagne;
    background: transparent;
  }

  .hero__btn--ghost:hover {
    background: rgba($champagne, 0.08);
  }

  .hero__art {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 280px;
  }

  .hero__sculpture {
    transform: translateY(8%);
    max-width: min(280px, 55vw);
  }

  .hero__sculpture :global(svg) {
    width: 100%;
    height: auto;
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      text-align: left;
    }

    .hero__art {
      justify-content: flex-start;
      min-height: 0;
    }

    .hero__sculpture {
      max-width: 200px;
      margin-top: 1rem;
    }
  }
</style>

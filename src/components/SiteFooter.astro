---
import BrandLogo from './BrandLogo.astro';
import { localeFromUrl, localePath } from '../i18n/seo';

const locale = localeFromUrl(Astro.url.pathname);
const year = new Date().getFullYear();
const wa = 'https://api.whatsapp.com/send?phone=+351935871091';
const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=CAN+D%27ORO+Lisboa';
---

<footer class="site-footer">
  <div class="site-footer__inner u-container">
    <BrandLogo variant="footer" />
    <div class="site-footer__cols">
      <div>
        <p class="site-footer__heading">
          <span class="i18n-en" lang="en">Menu</span><span class="i18n-pt" lang="pt">Menu</span>
        </p>
        <ul>
          <li>
            <a href={localePath(locale, '#home')}>
              <span class="i18n-en" lang="en">Home</span><span class="i18n-pt" lang="pt">Início</span>
            </a>
          </li>
          <li>
            <a href={localePath(locale, '#services')}>
              <span class="i18n-en" lang="en">Services</span><span class="i18n-pt" lang="pt">Serviços</span>
            </a>
          </li>
          <li>
            <a href={localePath(locale, '#portfolio')}>
              <span class="i18n-en" lang="en">Portfolio</span><span class="i18n-pt" lang="pt">Portfólio</span>
            </a>
          </li>
          <li>
            <a href={localePath(locale, '#philosophy')}>
              <span class="i18n-en" lang="en">About</span><span class="i18n-pt" lang="pt">Sobre</span>
            </a>
          </li>
          <li>
            <a href={localePath(locale, '#contact')}>
              <span class="i18n-en" lang="en">Contact</span><span class="i18n-pt" lang="pt">Contacto</span>
            </a>
          </li>
        </ul>
      </div>
      <div>
        <p class="site-footer__heading">
          <span class="i18n-en" lang="en">Visit us</span><span class="i18n-pt" lang="pt">Visite-nos</span>
        </p>
        <p class="site-footer__text">
          <a href={mapsUrl} rel="noopener noreferrer" target="_blank">
            <span class="i18n-en" lang="en">Lisbon, Portugal</span><span class="i18n-pt" lang="pt">Lisboa, Portugal</span>
          </a>
        </p>
        <p class="site-footer__text">
          <a href={wa}>+351 935 871 091</a>
        </p>
        <p class="site-footer__text">
          <span class="i18n-en" lang="en">By appointment only.</span><span class="i18n-pt" lang="pt">Apenas com marcação.</span>
        </p>
      </div>
      <div>
        <p class="site-footer__heading">
          <span class="i18n-en" lang="en">Follow</span><span class="i18n-pt" lang="pt">Seguir</span>
        </p>
        <ul class="site-footer__social">
          <li>
            <a href="https://www.instagram.com/candoro_salon" aria-label="Instagram">
              <span class="i18n-en" lang="en">Instagram</span><span class="i18n-pt" lang="pt">Instagram</span>
            </a>
          </li>
          <!-- <li>
            <a href="https://www.facebook.com/" aria-label="Facebook">
              <span class="i18n-en" lang="en">Facebook</span><span class="i18n-pt" lang="pt">Facebook</span>
            </a>
          </li> -->
        </ul>
      </div>
    </div>
  </div>
  <p class="site-footer__legal u-container">
    <span class="i18n-en" lang="en">© {year} CAN D'ORO. All rights reserved.</span>
    <span class="i18n-pt" lang="pt">© {year} CAN D'ORO. Todos os direitos reservados.</span>
  </p>
  <p class="site-footer__lang u-container">
    <a
      class="site-footer__lang-link"
      href={localePath('en')}
      hreflang="en"
      lang="en"
      aria-current={locale === 'en' ? 'page' : undefined}
    >
      English
    </a>
    <span class="site-footer__lang-sep" aria-hidden="true"> · </span>
    <a
      class="site-footer__lang-link"
      href={localePath('pt')}
      hreflang="pt"
      lang="pt"
      aria-current={locale === 'pt' ? 'page' : undefined}
    >
      Português
    </a>
  </p>
</footer>

<style lang="scss">
  @use '../styles/tokens' as *;

  .site-footer {
    background: $burgundy-deep;
    color: rgba(255, 255, 255, 0.82);
    padding: 4rem 0 2rem;
    margin-top: 0;
  }

  .site-footer__inner {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr 2fr;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .site-footer__heading {
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0 0 1rem;
    color: $champagne;
    font-weight: 600;
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .site-footer a {
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .site-footer a:hover {
    color: $champagne;
  }

  .site-footer__text {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.88;
  }

  .site-footer__social {
    gap: 0.65rem;
  }

  .site-footer__legal {
    margin: 1.5rem auto 0;
    font-size: 0.8rem;
    opacity: 0.45;
    text-align: center;
  }

  .site-footer__lang {
    margin: 0.85rem auto 0;
    font-size: 0.8rem;
    opacity: 0.55;
    text-align: center;
  }

  .site-footer__lang-link {
    display: inline;
    margin: 0;
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .site-footer__lang-link:hover {
    color: $champagne;
    text-decoration: none;
  }

  .site-footer__lang-link[aria-current='page'] {
    color: $champagne;
    text-decoration: none;
    font-weight: 600;
  }

  .site-footer__lang-sep {
    opacity: 0.65;
  }

  @media (max-width: 800px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }

    .site-footer__cols {
      grid-template-columns: 1fr;
    }
  }
</style>

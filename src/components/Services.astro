---
import SculptureAccent from './SculptureAccent.astro';

const services = [
  {
    title: { en: 'Breed styling', pt: 'Estética de raça' },
    text: {
      en: 'Silhouettes and coat direction guided by breed standard and your dog’s lifestyle.',
      pt: 'Silhuetas e direção do pelo guiadas pelo padrão da raça e pelo estilo de vida do seu cão.',
    },
    variant: 'brass' as const,
  },
  {
    title: { en: 'Puppy introduction', pt: 'Introdução de cachorro' },
    text: {
      en: 'Gentle first visits that build trust, table confidence, and healthy coat routines.',
      pt: 'Primeiras visitas suaves que constroem confiança, segurança na mesa e rotinas saudáveis de pelo.',
    },
    variant: 'porcelain' as const,
  },
  {
    title: { en: 'Hand stripping', pt: 'Stripping manual' },
    text: {
      en: 'Terriers and wired coats finished with traditional techniques for correct texture.',
      pt: 'Terriers e pelos cerdosos finalizados com técnicas tradicionais para a textura correta.',
    },
    variant: 'marble' as const,
  },
  {
    title: { en: 'Spa & coat care', pt: 'Spa e cuidado do pelo' },
    text: {
      en: 'Conditioning baths, skin-supporting products, and detail work for show-ready shine.',
      pt: 'Banhos de condicionamento, produtos que apoiam a pele e detalhe para um brilho pronto para exposição.',
    },
    variant: 'resin' as const,
  },
];
---

<section class="services" id="services" aria-labelledby="services-heading">
  <div class="services__head u-container" data-reveal>
    <p class="u-eyebrow services__eyebrow">
      <span class="i18n-en" lang="en">Signature services</span><span class="i18n-pt" lang="pt">Serviços de assinatura</span>
    </p>
    <h2 id="services-heading" class="services__title">
      <span class="i18n-en" lang="en">Tailored care for every dog.</span><span class="i18n-pt" lang="pt"
        >Cuidado sob medida para cada cão.</span
      >
    </h2>
  </div>
  <div class="services__grid u-container">
    {
      services.map((s) => (
        <article class="services__card" data-reveal>
          <div class="services__mascot">
            <SculptureAccent variant={s.variant} />
          </div>
          <h3 class="services__name">
            <span class="i18n-en" lang="en">{s.title.en}</span>
            <span class="i18n-pt" lang="pt">{s.title.pt}</span>
          </h3>
          <p class="services__text">
            <span class="i18n-en" lang="en">{s.text.en}</span>
            <span class="i18n-pt" lang="pt">{s.text.pt}</span>
          </p>
          <a class="services__more" href={`${import.meta.env.BASE_URL}#contact`}>
            <span class="i18n-en" lang="en">Learn more →</span><span class="i18n-pt" lang="pt">Saber mais →</span>
          </a>
        </article>
      ))
    }
  </div>
</section>

<style lang="scss">
  @use '../styles/tokens' as *;

  .services {
    padding: clamp(4rem, 10vw, 6.5rem) 0;
    background: $burgundy;
    color: rgba(255, 255, 255, 0.92);
  }

  .services__head {
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
    margin-bottom: 3rem;
  }

  .services__eyebrow {
    color: rgba($champagne, 0.95);
  }

  .services__title {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    margin: 0.75rem 0 0;
    font-weight: 500;
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .services__card {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .services__mascot {
    display: flex;
    justify-content: center;
    min-height: 140px;
    align-items: center;
  }

  .services__mascot :global(.sculpture-accent) {
    opacity: 0.5;
    max-width: 100px;
  }

  .services__mascot :global(svg) {
    width: 100%;
    height: auto;
  }

  .services__name {
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-family: $font-sans;
    font-weight: 700;
    color: $champagne;
    margin: 0;
  }

  .services__text {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.65;
    opacity: 0.86;
    flex: 1;
  }

  .services__more {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    color: rgba($champagne, 0.95);
    text-decoration: none;
    margin-top: 0.25rem;
  }

  .services__more:hover {
    color: #fff;
  }

  @media (max-width: 960px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
